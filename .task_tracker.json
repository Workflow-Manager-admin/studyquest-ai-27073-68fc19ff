{
  "task_description": "{'component_name': 'Main Container for StudyQuest AI', 'description': 'Primary container for StudyQuest AI implementation: Reviser is a web application designed for students to upload study materials in PDF and Word (.docx) formats. It extracts text from these documents, analyzes the content, and automatically generates multiple-choice questions (MCQs) using NLP/LLM APIs. Students can practice with interactive quizzes, receive instant feedback, and optionally download or save MCQs for later revision.', 'framework': 'express', 'platform': 'web', 'container': '{\n  "name": "ColorCraft backend Container",\n  "features": [\n    {\n      "name": "File Upload (.pdf, .docx)",\n      "description": "Allows users to upload PDF and Word documents for analysis.",\n      "isEnabled": true\n    },\n    {\n      "name": "Content Extraction",\n      "description": "Extracts readable text from uploaded documents using server-side processing and/or third-party APIs.",\n      "isEnabled": true\n    },\n    {\n      "name": "MCQ Generation",\n      "description": "Analyzes extracted text and generates relevant MCQs using NLP/LLM APIs such as OpenAI or Cohere.",\n      "isEnabled": true\n    },\n    {\n      "name": "Interactive Quiz",\n      "description": "Displays generated MCQs in a quiz format, allowing students to select answers and receive immediate feedback.",\n      "isEnabled": true\n    },\n    {\n      "name": "API Integration",\n      "description": "Integrates with third-party APIs for text extraction and question generation.",\n      "isEnabled": true\n    },\n    {\n      "name": "Clean Student-Friendly UI",\n      "description": "Provides a modern, intuitive, and accessible interface for students.",\n      "isEnabled": true\n    },\n    {\n      "name": "Backend Processing",\n      "description": "Handles file uploads, text extraction, MCQ generation, and API communication on the server side.",\n      "isEnabled": true\n    },\n    {\n      "name": "Download MCQs as PDF (Optional)",\n      "description": "Allows students to download generated MCQs as a PDF file.",\n      "isEnabled": false\n    },\n    {\n      "name": "Save MCQs to Account (Optional)",\n      "description": "Lets students save MCQs for later practice if login/account support is enabled.",\n      "isEnabled": false\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "None"\n    ],\n    "backend": [\n      "Express.js"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#000000",\n    "secondary": "#40916C",\n    "accent": "#FFD166"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a prominent upload area for PDF and DOCX files, followed by a progress indicator during processing. Once MCQs are generated, they are displayed in a clean, card-based quiz format with answer selection and instant feedback. Navigation is simple, with clear calls to action for downloading or saving MCQs (if enabled). The design uses a modern, student-friendly color palette and responsive layout for accessibility on all devices."\n}'}",
